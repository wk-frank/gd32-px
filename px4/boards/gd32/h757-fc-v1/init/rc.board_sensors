#
# Sensor & FRAM MTD startup script for gd32_h757-fc-v1 (PX4 v1.17.0)
#

# 0. Mount 256Kbit FRAM (Infineon FM25V02A-GTR on SPI3 / PX4 bus 4) for zero-latency parameters
if mtd status
then
	mtd start -b 4
fi

# 1. Primary IMU: TDK ICM-42688-P on SPI0 (PX4 bus 1, EXTI4 DRDY)
icm42688p -s -b 1 -R 0 start

# 2. Redundant Heterogeneous IMU: Bosch BMI088 on SPI1 (PX4 bus 2, Dual CS + Dual DRDY)
bmi088 -A -s -b 2 -R 0 start
bmi088 -G -s -b 2 -R 0 start

# 3. Onboard Barometer & Magnetometer on I2C0 (PX4 bus 1: PB6/PB7)
bmp390 -I -b 1 -a 0x76 start
bmm150 -I -b 1 start

# 4. External GPS1 Compass on I2C1 (PX4 bus 2: PF1/PF0)
ist8310 -X -b 2 start

# 5. Digital Power Monitor: TI INA226 on I2C3 (PX4 bus 4: PF14/PF15)
ina226 -I -b 4 -a 0x41 start
